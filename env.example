# Cloudflare Integration Configuration
# Create your API token at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:Read, Zone:Edit, Workers:Edit, D1:Edit
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# JWT Token for Cloudflare Worker Authentication
# This should match the JWT_TOKEN in your wrangler.toml if you have an existing worker
# If deploying a new worker, you can leave this empty to auto-generate
# If your worker uses a JWT, set it at deploy time via `wrangler secret put CLOUDFLARE_JWT_TOKEN`.
# Do NOT commit real secrets to version control.
# CLOUDFLARE_JWT_TOKEN=<your_worker_jwt_here>
# Optional: Default values for new worker deployments
# These can be overridden in the UI during setup
# CLOUDFLARE_DEFAULT_WORKER_NAME=duckmail-worker
# CLOUDFLARE_DEFAULT_D1_NAME=temp_mail_db

# Client-IP signing for the Worker's failed-login limits (server-only, never NEXT_PUBLIC_).
# Same value as the Worker secret CLIENT_IP_SECRET, 32+ random characters. The /api/mail proxy
# signs each browser's IP with it (X-DuckMail-Client-IP), so the Worker limits failed logins per
# user instead of per this server. Unset = the Worker counts every web-app user as one client.
# CLIENT_IP_SECRET=

# Logging / Debug Controls
# Set to enable verbose Cloudflare and app debug logs in server console and browser devtools.
# Accepts: 1|true|yes|on (case-insensitive). Any other value disables debug logs.
# cf_debug=1
# CF_DEBUG=1
# NEXT_PUBLIC_CF_DEBUG=1

# Application Settings
# NODE_ENV=production
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Database (if using local database)
# DATABASE_URL=postgresql://user:password@localhost:5432/duckmail

# Email Provider Settings (optional)
# RESEND_API_KEY=your_resend_api_key_here
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password 